# .env.example
# Copy to .env and fill in required values.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# OpenAI (optional if using Anthropic or Ollama; can also be set per-user in the UI)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Anthropic (optional; can also be set per-user in the UI)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---------------------------------------------------------------------------
# Ollama (LLM — runs inside Docker, no external API key needed)
# ---------------------------------------------------------------------------
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3

# ---------------------------------------------------------------------------
# Kali Sidecar API
# ---------------------------------------------------------------------------
KALI_SIDECAR_URL=http://kali-sidecar:5000

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=kalimcp
POSTGRES_USER=kalimcp
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
# POSTGRES_DSN is constructed automatically in docker-compose.yml
# If running outside Docker Compose, set it explicitly:
# POSTGRES_DSN=postgresql+asyncpg://kalimcp:replace-with-a-strong-postgres-password@localhost:5432/kalimcp

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=replace-with-a-strong-redis-password
# REDIS_URL is constructed automatically in docker-compose.yml
# If running outside Docker Compose, set it explicitly:
# REDIS_URL=redis://:replace-with-a-strong-redis-password@localhost:6379/0

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-64-hex-chars-generated-by-secrets-token-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=production
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Kali LAN Bridge (macvlan) — docker-compose.bridge.yml overlay
# Gives the Kali container a real IP on your LAN, visible to other hosts.
#
# Linux:  set KALI_BRIDGE_IFACE to your host NIC (check with: ip link)
#         then run: make bridge-promisc && make bridge-up
# macOS:  Docker Desktop runs in a VM; containers won't appear on Mac's LAN.
#         Deploy on a Linux host for true macvlan LAN bridging.
# ---------------------------------------------------------------------------
# Host NIC to bridge onto (eth0, ens3, eno1, en0, wlan0, …)
KALI_BRIDGE_IFACE=eth0
# Your LAN subnet and default gateway
KALI_LAN_SUBNET=192.168.1.0/24
KALI_LAN_GW=192.168.1.1
# Static IP for the Kali container — must be in KALI_LAN_SUBNET and free
KALI_LAN_IP=192.168.1.250
# Range Docker may auto-assign from (keep small to avoid conflicts)
KALI_IP_RANGE=192.168.1.240/28
